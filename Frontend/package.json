{
  "name": "open-hd-management-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:port": "node -e 'const fs=require(\"fs\"); const port=process.argv[2]||\"8080\"; fs.writeFileSync(\"src/assets/env.js\", `(function(w){w.env=w.env||{};w.env.BACKEND_PORT=\"${port}\"})(this);`); console.log(\"Backend port set to:\", port);' && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:OpenHD-Management-Frontend": "node dist/open-hd-management-frontend/server/server.mjs",
    "sbom": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --omit dev --spec-version 1.5 --output-format json --output-file sbom-frontend.json || true",
    "sbom:xml": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --omit dev --spec-version 1.5 --output-format xml --output-file sbom-frontend.xml || true",
    "prestart": "node scripts/generate-build-info.js",
    "prestart:port": "node scripts/generate-build-info.js",
    "prebuild": "node scripts/generate-build-info.js",
    "prewatch": "node scripts/generate-build-info.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.5",
    "@apollo/client": "^3.14.1",
    "@nestjs/graphql": "13.0.3",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^11.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "1.13.1",
    "express": "^4.22.2",
    "graphql": "^16.14.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^22.20.1",
    "@vitest/ui": "^3.0.0",
    "@analogjs/vite-plugin-angular": "^1.9.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.0",
    "libxmljs2": "0.37.0",
    "typescript": "~6.0.2"
  }
}
